# Central workshop defaults. Copy to /opt/tritondft/config/.env.cluster_admin
# and insert a restricted, temporary workshop API key. Never commit that file.
# When true, users cannot override the API keys, provider, backend, or model.
TRITONDFT_ADMIN_LOCK_PROVIDER=true
OPENAI_API_KEY=
MP_API_KEY=
CLUSTER_AGENT_MODEL=gpt-5.6-terra
CLUSTER_AGENT_BACKEND=openai
