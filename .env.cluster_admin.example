# Central workshop defaults. Copy to /opt/tritondft/config/.env.cluster_admin
# and insert a restricted, temporary workshop API key. Never commit that file.
OPENAI_API_KEY=
MP_API_KEY=
CLUSTER_AGENT_MODEL=gpt-5.6-terra
CLUSTER_AGENT_BACKEND=openai
CLUSTER_AGENT_SSH_TARGET=
CLUSTER_AGENT_REMOTE_ROOT=
CLUSTER_AGENT_WORK_DIR=tmp
CLUSTER_AGENT_POLL_SECONDS=30
TRITONDFT_QE_SLURM_TEMPLATE=/opt/tritondft/config/lawrencium_qe.sh
CLUSTER_AGENT_REMOTE_QE_BIN_DIR=
CLUSTER_AGENT_QE_VERSION=
CLUSTER_AGENT_NO_QUERY_INFO=false
